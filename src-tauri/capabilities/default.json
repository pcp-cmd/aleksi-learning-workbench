{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Minimal capability set for the Aleksi Workbench main window",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-desktop-runtime-snapshot",
    "allow-export-diagnostics",
    "allow-force-exit",
    "allow-open-learning-library",
    "allow-request-exit",
    "allow-read-selected-reading-part",
    "allow-restart-sidecar",
    "allow-select-learning-library",
    "allow-select-reading-file"
  ]
}
