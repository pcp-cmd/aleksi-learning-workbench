{
  "name": "aleksi-learning-workbench",
  "version": "0.1.5-rc.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/development-entry.ts",
    "build": "tsc -b && vite build",
    "build:runtime": "npm run build && node scripts/build-runtime.mjs",
    "prepare:desktop": "npm run build:runtime && npm run verify:fonts && node scripts/prepare-desktop.mjs",
    "desktop:dev": "npm run prepare:desktop && tauri dev",
    "build:desktop": "npm run prepare:desktop && tauri build --bundles nsis",
    "package:desktop": "node scripts/package-desktop.mjs",
    "package:release": "node scripts/package-release.mjs",
    "report:installed": "node scripts/write-installed-test-reports.mjs",
    "start": "tsx server/development-entry.ts",
    "start:dev": "npm run dev",
    "start:runtime": "node scripts/start-runtime.mjs",
    "typecheck": "tsc -b --pretty false",
    "architecture": "vitest run tests/server/architecture-boundaries.test.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:browser:production": "npm run build && playwright test --config=playwright.production.config.ts",
    "package:source": "node scripts/package-source.mjs",
    "package:audit": "node scripts/audit-package.mjs artifacts/aleksi-learning-workbench-source.zip",
    "audit:release": "node scripts/verify-npm-audit.mjs",
    "package:desktop-source": "node scripts/package-source.mjs artifacts/Aleksi-Learning-Workbench-Source-0.1.4-Final.zip",
    "audit:desktop-source": "node scripts/audit-package.mjs artifacts/Aleksi-Learning-Workbench-Source-0.1.4-Final.zip",
    "package:runtime": "npm run build:runtime && node scripts/package-runtime.mjs",
    "audit:runtime": "node scripts/audit-runtime.mjs artifacts/AleksiWorkbench-Preview-win-x64.zip",
    "health:source": "node scripts/health-source.mjs",
    "verify:clean-base": "node scripts/verify-clean-base.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "verify:desktop:source": "node scripts/verify-desktop-source.mjs",
    "verify:desktop": "node scripts/verify-desktop.mjs",
    "verify:uninstall-reinstall": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify-uninstall-reinstall.ps1",
    "verify": "npm run typecheck && npm run test && npm run build && npm run verify:fonts",
    "verify:all": "npm run verify && npm run test:browser",
    "verify:packaged-sidecar": "node scripts/verify-packaged-sidecar.mjs",
    "test:release:server": "node scripts/run-release-tests.mjs server",
    "test:release:api": "node scripts/run-release-tests.mjs api",
    "test:release": "npm run test:release:server && npm run test:release:api && npm run test:release:ui",
    "test:release:ui": "node scripts/run-release-tests.mjs ui",
    "verify:fonts": "node scripts/verify-font-delivery.mjs",
    "generate:archival-matrix": "node scripts/generate-archival-verification-matrix.mjs",
    "generate:current-contract": "node scripts/generate-current-contract.mjs",
    "check:current-contract": "node scripts/generate-current-contract.mjs --check"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.80.0",
    "@tauri-apps/api": "^2.11.1",
    "express": "^5.1.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.22",
    "lottie-web": "^5.13.0",
    "lucide-react": "1.24.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "7.18.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.2.4",
    "esbuild": "^0.28.1",
    "jsdom": "^26.1.0",
    "supertest": "^7.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0"
  }
}
